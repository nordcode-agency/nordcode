---
import ExposeCard from "../../components/ExposeCard.astro";
import Layout from "../../layouts/Layout.astro";
import Features from "../../components/Features.astro";
import mainImage1Src from "../../assets/images/house-1-nordcode.jpg";
import mainImage2Src from "../../assets/images/house-2-nordcode.jpg";
import mainImage3Src from "../../assets/images/house-3-nordcode.jpg";
import FinalCTA from "../../components/FinalCTA.astro";

const BOOK_APPOINTMENT_LINK = "https://buch.suri-alaia.com/joshua";
const DEMO_LINK = "https://immos.nordcode.agency";

const features = [
    {
        title: "Professioneller erster Eindruck",
        description:
            "Eine moderne, individuelle Website, die Vertrauen schafft und Ihre Immobilien ins beste Licht rückt.",
    },
    {
        title: "Mehr Anfragen, weniger Aufwand",
        description:
            "Bessere Sichtbarkeit in Suchmaschinen und KI-Assistenten bringt qualifizierte Interessenten direkt zu Ihnen – ohne Abhängigkeit von teuren Portalen.",
    },
    {
        title: "Ihr Auftritt, Ihre Marke",
        description:
            "Design und Inhalte werden passgenau auf Ihr Branding abgestimmt, sodass Ihre Website unverwechselbar bleibt.",
    },
    {
        title: "Automatisch aktuell",
        description:
            "Ihre Exposés werden direkt aus Ihren bestehenden CRM-Daten (OpenImmo) generiert – kein doppeltes Einpflegen, keine veralteten Angebote.",
    },
    {
        title: "Unabhängigkeit von großen Portalen",
        description:
            "Obwohl Sie vermutlich aktuell nicht auf ImmobilienScout & Co verzichten können, sparen Sie richtig Geld, wenn Interessierte sie direkt kontaktieren.",
    },
];
---

<Layout
    title="Ansprechende Website für Immobilienmakler"
    noIndex
    description="Wir bieten auf dein Unternehmen zugeschnittene Weblösungen im Immobilienbereich. Präsentieren Sie Ihre Objekte effizient und portalunabhängig – einmalig investiert, ohne Abo-Gebühren."
>
    <section class="nc-box section hero">
        <div class="hero-content">
            <div class="content">
                <h1 class="title">Moderne Websites für Immobilienmakler.</h1>
                <h2 class="subtitle">
                    Moderne Darstellung und einfache Verwaltung Ihres Immobilienportfolios.
                </h2>
                <div class="nc-cluster">
                    <a href={BOOK_APPOINTMENT_LINK} target="_blank" class="nc-button cta"
                        >Jetzt anfragen</a
                    >
                    <a href={DEMO_LINK} target="_blank" class="nc-button -muted cta">Demo ansehen</a
                    >
                </div>
            </div>
        </div>
        <div class="hero-image">
            <div class="shadow-sticker"></div>
            <div class="track nc-stack">
                {
                    [
                        {
                            imageSrc: mainImage1Src,
                            address: "25992 List auf Sylt",
                            id: "144841147",
                            imageDesc: "Frontansicht des Hauses",
                            price: 639000,
                            rooms: "5 Zi.",
                            squareMeters: "125 m²",
                            title: "Schönes Reetdachhaus auf Sylt",
                        },
                        {
                            imageSrc: mainImage2Src,
                            address: "23554 Lübeck",
                            id: "144841148",
                            imageDesc: "Außenansicht der Wohnung",
                            price: 525000,
                            rooms: "3 Zi.",
                            squareMeters: "78 m²",
                            title: "Elegante Stadtwohnung mit Balkon",
                        },
                        {
                            imageSrc: mainImage3Src,
                            address: "Blankenese, 22587 Hamburg",
                            id: "144841149",
                            imageDesc: "Gartenansicht des Einfamilienhauses",
                            price: 337000,
                            rooms: "6 Zi.",
                            squareMeters: "210 m²",
                            title: "Großzügiges Einfamilienhaus mit Garten",
                        },
                    ].map(({ imageSrc, ...props }, i) => (
                        <div class="item" style={`--nth-child: ${i + 1}`}>
                            <ExposeCard imageSrc={imageSrc} {...props} />
                        </div>
                    ))
                }
            </div>
        </div>
    </section>
    <Features
        features={features}
        title="Geben Sie Ihren Immobilien die Sichtbarkeit die sie verdienen"
        id="immofeatures"
    />
    <FinalCTA>
        <a slot="firstCTA" class="nc-button -brand" href={BOOK_APPOINTMENT_LINK} target="_blank"
            >Jetzt anfragen</a
        >
    </FinalCTA>
</Layout>

<style>
    @custom-media --md-n-above (width >= 768px);
    @custom-media --lg-n-above (width >= 1024px);
    @custom-media --xl-n-above (width >= 1440px);

    section.hero {
        display: grid;
        padding-block: 0;

        @media (--lg-n-above) {
            grid-template-rows: auto;
            grid-template-columns: 1fr 1fr;
        }

        & > div {
            grid-area: 1 / 1;

            @media (--lg-n-above) {
                grid-area: auto;
            }
        }
    }

    .hero-content {
        padding-block: calc(var(--spacing-adaptive) * 2);
        z-index: 2;
        background: linear-gradient(to bottom, var(--color-surface-muted) 30%, transparent);

        @media (--md-n-above) {
            background:
                linear-gradient(to right, var(--color-surface-muted) 40%, transparent),
                radial-gradient(circle, var(--color-surface-muted) 0%, transparent 70%);
        }
    }

    .content {
        max-inline-size: 40ch;

        @media (--lg-n-above) {
            max-inline-size: 48ch;
        }
    }

    .hero-image {
        --gap: var(--spacing-base);

        margin-inline-start: auto;
        position: relative;
        overflow-block: clip;
        max-block-size: 70vh;

        @media (--lg-n-above) {
            margin-inline-end: auto;
        }
    }

    .shadow-sticker,
    .hero-image::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        block-size: var(--gap);
        z-index: 1;
        transform: translateY(-100%);
        box-shadow: 0px 0px calc(var(--gap) * 1) calc(var(--gap) * 1.1) var(--color-surface-muted);
        overflow: clip;
    }

    .shadow-sticker {
        position: sticky;
    }

    .hero-image::after {
        inset-block-start: 100%;
        inset-block-end: 0;
        transform: translateY(calc(100% - var(--gap)));
    }

    .title {
        margin-block-end: var(--spacing-base);
        font-size: 2.2rem;

        @media (--md-n-above) {
            font-size: 2.6rem;
        }

        @media (--xl-n-above) {
            font-size: var(--font-size-display);
        }
    }

    .subtitle {
        opacity: 0.6;
        font-size: 1.2rem;
        font-weight: var(--font-weight-normal);
        line-height: 1.3;

        @media (--md-n-above) {
            font-size: var(--font-size-largest);
        }
        @media (--lg-n-above) {
            font-size: var(--font-size-largest);
        }
    }

    .cta {
        margin-block-start: var(--spacing-base);
    }

    .track {
        max-inline-size: 28rem;
        margin-inline: auto;
        animation: track-rise var(--ease-in-out-1) both;
        animation-timeline: scroll(root);
        animation-range: 0 50vh;
    }

    @keyframes track-rise {
        from {
            translate: 0 0;
        }
        to {
            translate: 0 -26rem;
        }
    }

    .item {
    }
</style>
