---
import ExposeCard from "../../components/ExposeCard.astro";
import Layout from "../../layouts/Layout.astro";
import Features from "../../components/Features.astro";
import mainImage1Src from "../../assets/images/house-1-nordcode.jpg";
import mainImage2Src from "../../assets/images/house-2-nordcode.jpg";
import mainImage3Src from "../../assets/images/house-3-nordcode.jpg";
import FinalCTA from "../../components/FinalCTA.astro";

const BOOK_APPOINTMENT_LINK = "https://buch.suri-alaia.com/joshua";
const DEMO_LINK = "https://immos.nordcode.agency";

const features = [
    {
        title: "Professioneller erster Eindruck",
        description:
            "Eine moderne, individuelle Website, die Vertrauen schafft und deine Immobilien ins beste Licht rückt.",
    },
    {
        title: "Mehr Anfragen, weniger Aufwand",
        description:
            "Bessere Sichtbarkeit in Suchmaschinen und KI-Assistenten bringt qualifizierte Interessenten direkt zu dir – ohne Abhängigkeit von teuren Portalen.",
    },
    {
        title: "Dein Auftritt, deine Marke",
        description:
            "Design und Inhalte werden passgenau auf dein Branding abgestimmt, sodass deine Website unverwechselbar bleibt.",
    },
    {
        title: "Automatisch aktuell",
        description:
            "Deine Exposés werden direkt aus deinen bestehenden CRM-Daten (OpenImmo) generiert – kein doppeltes Einpflegen, keine veralteten Angebote.",
    },
    {
        title: "Unabhängigkeit, die sich auszahlt",
        description:
            "Jede Anfrage, die über deine Website statt ein großes Portal geht, spart bares Geld.",
    },
];
---

<Layout
    title="Moderne Websites für Immobilienmakler."
    description="Wir bieten auf dein Unternehmen zugeschnittene Weblösungen im Immobilienbereich. Präsentiere deine Objekte effizient und portalunabhängig – einmalig investiert, ohne Abo-Gebühren."
>
    <section class="nc-box section hero">
        <div class="hero-content">
            <div class="content">
                <h1 class="title">Moderne Websites für Immobilienmakler.</h1>
                <h2 class="subtitle">
                    Ein <strong>neues Zuhause</strong> für deine Immobilien
                </h2>
                <div class="nc-cluster">
                    <a href={BOOK_APPOINTMENT_LINK} target="_blank" class="nc-button cta"
                        >Jetzt anfragen</a
                    >
                    <a href={DEMO_LINK} target="_blank" class="nc-button -muted cta">Demo ansehen</a
                    >
                </div>
            </div>
        </div>
        <div class="hero-image">
            <div class="shadow-sticker"></div>
            <div class="track nc-stack">
                {
                    [
                        {
                            imageSrc: mainImage1Src,
                            address: "25992 List auf Sylt",
                            id: "1348560004",
                            imageDesc: "Frontansicht des Hauses",
                            price: 639000,
                            rooms: "5 Zi.",
                            squareMeters: "125 m²",
                            title: "Schönes Reetdachhaus auf Sylt",
                        },
                        {
                            imageSrc: mainImage2Src,
                            address: "23554 Lübeck",
                            id: "1669761550",
                            imageDesc: "Außenansicht der Wohnung",
                            price: 525000,
                            rooms: "3 Zi.",
                            squareMeters: "78 m²",
                            title: "Elegante Stadtwohnung mit Balkon",
                        },
                        {
                            imageSrc: mainImage3Src,
                            address: "Blankenese, 22587 Hamburg",
                            id: "1219416652",
                            imageDesc: "Gartenansicht des Einfamilienhauses",
                            price: 337000,
                            rooms: "6 Zi.",
                            squareMeters: "210 m²",
                            title: "Großzügiges Einfamilienhaus mit Garten",
                        },
                    ].map(({ imageSrc, ...props }, i) => (
                        <div class="item" style={`--nth-child: ${i + 1}`}>
                            <ExposeCard imageSrc={imageSrc} {...props} />
                        </div>
                    ))
                }
            </div>
        </div>
    </section>
    <Features
        features={features}
        title="Gib deinen Immobilien die Sichtbarkeit, die sie verdienen"
        id="immofeatures"
    />
    <section class="section nc-box container nc-center">
        <div class="nc-flow prose immo-teaser">
            <h2 class="title">Neugierig geworden?</h2>
            <p>
                Wenn du dir ein Bild davon machen willst, wie deine Immobilien auf der Website
                aussiehen, haben wir eine Demonstrationsseite aufgesetzt.
            </p>
            <p>
                Dort kannst du dir direkt angucken, wie die Immobilienexposés in modernem Design
                ansehen. <strong>Sie wird natürlich noch ein dein Design angepasst.</strong>
            </p>
            <a href="https://immos.nordcode.agency" class="nc-button -brand -big"
                >Guck dir die Demo an</a
            >
        </div>
    </section>
    <section class="section">
        <div class="nc-box">
            <FinalCTA>
                <a
                    slot="firstCTA"
                    class="nc-button -brand"
                    href={BOOK_APPOINTMENT_LINK}
                    target="_blank">Jetzt anfragen</a
                >
            </FinalCTA>
        </div>
    </section>
</Layout>

<style>
    @custom-media --sm-n-above (width >= 480px);
    @custom-media --md-n-above (width >= 768px);
    @custom-media --lg-n-above (width >= 1024px);
    @custom-media --xl-n-above (width >= 1440px);

    section.hero {
        display: grid;
        padding-block: 0;
        gap: var(--spacing-base);

        @media (--sm-n-above) {
            & > div {
                grid-area: 1 / 1;
            }
        }

        @media (--lg-n-above) {
            gap: var(--spacing-far);
            grid-template-rows: auto;
            grid-template-columns: 1fr 1fr;

            & > div {
                grid-area: auto;
            }
        }
    }

    .hero-content {
        padding-block: calc(var(--spacing-adaptive) * 2);
        z-index: 2;
        background: linear-gradient(to bottom, var(--color-surface-muted) 30%, transparent);

        @media (--md-n-above) {
            background:
                linear-gradient(to right, var(--color-surface-muted) 40%, transparent),
                radial-gradient(circle, var(--color-surface-muted) 0%, transparent 70%);
        }
    }

    .content {
        max-inline-size: 40ch;

        @media (--lg-n-above) {
            max-inline-size: 48ch;
        }
    }

    .hero-image {
        --gap: var(--spacing-base);

        margin-inline-start: auto;
        position: relative;
        overflow-block: clip;
        max-block-size: 70vh;

        @media (--lg-n-above) {
            margin-inline-end: auto;
        }
    }

    .shadow-sticker,
    .hero-image::after {
        content: "";
        position: absolute;
        inset: 0;
        pointer-events: none;
        block-size: var(--gap);
        z-index: 1;
        transform: translateY(-100%);
        box-shadow: 0px 0px calc(var(--gap) * 1) calc(var(--gap) * 1.1) var(--color-surface-muted);
        overflow: clip;
    }

    .shadow-sticker {
        position: sticky;
    }

    .hero-image::after {
        inset-block-start: 100%;
        inset-block-end: 0;
        transform: translateY(calc(100% - var(--gap)));
    }

    .title {
        margin-block-end: var(--spacing-base);
        font-size: 2.2rem;

        @media (--md-n-above) {
            font-size: 2.6rem;
        }

        @media (--xl-n-above) {
            font-size: var(--font-size-display);
        }
    }

    @custom-media --sm-n-above (width >= 480px);

    .subtitle {
        font-weight: var(--font-weight-default);
        letter-spacing: var(--tracking-base);
        font-size: var(--font-size-base);
        transform: translateX(0.3ch);
    }

    @media (--sm-n-above) {
        .subtitle {
            font-size: var(--font-size-large);
        }
    }

    .cta {
        margin-block-start: var(--spacing-far);
    }

    .track {
        max-inline-size: 28rem;
        margin-inline: auto;
        animation: track-rise var(--ease-in-out-1) both;
        animation-timeline: scroll(root);
        animation-range: 0 50vh;
    }

    @keyframes track-rise {
        from {
            translate: 0 0;
        }
        to {
            translate: 0 -26rem;
        }
    }

    .immo-teaser {
        inline-size: 100%;

        @media (--lg-n-above) {
            inline-size: min(48ch, 100%);
        }
        margin-inline: auto;

        & > h2 {
            margin-block-end: 0;
        }

        & > a {
            max-inline-size: 18rem;
        }
    }
</style>
