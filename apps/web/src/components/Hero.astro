---
import { Navigation } from "../config/navigation.ts";
import type { TProjects } from "../content/projects.ts";
import { ensureTrailingSlash } from "../utils/ensureTrailingSlash.ts";
import ActionCard from "./ActionCard.astro";

interface Props {
    projects?: TProjects;
}

const {} = Astro.props;
---

<div class="nc-stack container">
    <div class="headings">
        <h1 class="section-title nc-stack">
            <span class="maintitle">Webseiten, die begeistern</span>
            <span class="subtitle"
                ><strong> Deine</strong> Webagentur für gute digitale Projekte</span
            >
        </h1>
    </div>
    <div class="footer nc-box">
        <div class="footer-box">
            <ActionCard heading="Jetzt neu! Weblösung für Immobilienmakler">
                <a href={ensureTrailingSlash(Navigation.start.url)} class="nc-button -muted -big"
                    >Loslegen</a
                >
            </ActionCard>
        </div>
        <div class="footer-box">
            <ActionCard heading="Lass uns schauen, wie wir dir helfen können">
                <a href={ensureTrailingSlash(Navigation.immo.url)} class="nc-button -brand -big"
                    >Starte dein Projekt</a
                >
            </ActionCard>
        </div>
    </div>
</div>

<style>
    @custom-media --sm-n-above (width >= 480px);

    .subtitle {
        font-weight: var(--font-weight-default);
        letter-spacing: var(--tracking-base);
        font-size: var(--font-size-base);
        transform: translateX(0.3ch);
    }

    @media (--sm-n-above) {
        .subtitle {
            font-size: var(--font-size-large);
        }
    }

    .container {
        inline-size: 100%;
        flex-grow: 1;
    }

    .headings {
        max-inline-size: 68ch;
        padding-inline: var(--spacing-adaptive);
        flex-grow: 1;
        display: flex;
        align-items: center;
    }

    .footer {
        --size: 16rem;
        --gap: var(--spacing-far);

        margin-inline-start: auto;
        inline-size: min(100%, calc(3 * var(--size) + var(--gap)));
        display: flex;
        flex-wrap: wrap;
        justify-content: end;
        align-items: stretch;
        gap: var(--gap);
        padding-block: var(--spacing-far);
    }

    .footer-box {
        flex: 1 1 var(--size);
        backdrop-filter: blur(var(--spacing-base));
    }

    .-big {
        inline-size: 100%;

        @media (--sm-n-above) {
            --control-height-base: 3rem;

            font-size: var(--font-size-medium);
            letter-spacing: var(--tracking-tight);
        }
    }
</style>
