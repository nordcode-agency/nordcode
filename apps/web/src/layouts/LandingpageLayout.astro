---
import Layout from './Layout.astro';

export interface Props {
    title?: string;
    description?: string;
}

const {
    title = 'Website für Immobilienmakler - nordcode immos',
    description = 'nordcodeImmos: Ihre Immobilien perfekt in Szene gesetzt. Mit CRM-Integration & OpenImmo-Schnittstelle direkt auf Ihrer Website. Ohne Abo! Jetzt Demo anfragen.',
} = Astro.props;
---

<Layout title={title} description={description}>
    <article class="section nc-center work-page">
        <slot />
    </article>
</Layout>
